+    private void fastVerifyRng(final long s0, final int r, final int a, final int b, final int c, final int d, final int e, final int f) {
+        net.minecraft.world.level.levelgen.LegacyRandomSource probe = this.fastVerifyRandom;
+        if (probe == null) {
+            probe = this.fastVerifyRandom = new net.minecraft.world.level.levelgen.LegacyRandomSource(0L);
+        }
+        probe.setSeed(s0 ^ LCG_MULTIPLIER); // setSeed scrambles with ^ multiplier: the raw seed becomes s0
+        if (probe.nextInt(r) != a || probe.nextInt(r) != b || probe.nextInt(r) != c || probe.nextInt(r) != d || probe.nextInt(r) != e
+            || probe.nextInt(r) != f) {
+            this.fastVerifyFail("batched RNG differs from LegacyRandomSource.nextInt(" + r + ")");
+        }
+    }
