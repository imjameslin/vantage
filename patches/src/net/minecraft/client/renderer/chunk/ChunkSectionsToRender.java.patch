+    /** S5 / round 12 Part B: the pipeline for a group's vertex format. */
+    static RenderPipeline formatVariant(final RenderPipeline pipeline, final boolean compact, final boolean greedy) {
+        if (compact) {
+            return compactVariant(pipeline);
+        }
+        if (greedy) {
+            RenderPipeline variant = RenderPipelines.greedyTerrainVariant(pipeline);
+            if (variant == null) {
+                throw new IllegalStateException("No greedy terrain variant of " + pipeline.getLocation());
+            }
+            return variant;
+        }
+        return pipeline;
+    }
+
+    /** S5: the compact-vertex variant of a terrain pipeline (only SOLID/CUTOUT/wireframe layers are ever compact). */
+    static RenderPipeline compactVariant(final RenderPipeline pipeline) {
+        RenderPipeline variant = RenderPipelines.compactTerrainVariant(pipeline);
+        if (variant == null) {
+            throw new IllegalStateException("No compact terrain vertex variant of " + pipeline.getLocation());
+        }
+
+        return variant;
+    }
