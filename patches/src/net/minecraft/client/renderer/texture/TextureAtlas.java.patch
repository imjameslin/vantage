+     * textures' texels. Also caches the sprites' paddings. False if it would exceed the maximum texture size.
+     */
+    private boolean buildComputeFrames() {
+        int n = this.animatedSprites.size();
+        this.computePadding = new int[n];
+        List<GpuTexture> frames = new ArrayList<>();
+        for (int i = 0; i < n; i++) {
+            this.computePadding[i] = padding(this.animatedSprites.get(i));
+            for (GpuTexture t : this.animatedTexturesStates.get(i).computeFrameTextures()) {
+                if (!this.computeFrameOrigin.containsKey(t)) {
+                    this.computeFrameOrigin.put(t, new int[2]);
+                    frames.add(t);
+                }
+            }
+        }
+        frames.sort((a, b) -> Integer.compare(b.getHeight(0), a.getHeight(0)));
+        int align = 1 << this.maxMipLevel;
+        int widthLimit = 1024;
+        for (GpuTexture t : frames) {
+            widthLimit = Math.max(widthLimit, roundUp(t.getWidth(0), align));
+        }
+        int x = 0;
+        int y = 0;
+        int shelf = 0;
+        for (GpuTexture t : frames) {
+            int w = roundUp(t.getWidth(0), align);
+            int h = roundUp(t.getHeight(0), align);
+            if (x + w > widthLimit) {
+                x = 0;
+                y += shelf;
+                shelf = 0;
+            }
+            int[] origin = this.computeFrameOrigin.get(t);
+            origin[0] = x;
+            origin[1] = y;
+            x += w;
+            shelf = Math.max(shelf, h);
+        }
+        int height = roundUp(Math.max(1, y + shelf), align);
+        if (height > this.maxSupportedTextureSize || frames.isEmpty()) {
+            this.computeFrameOrigin.clear();
+            return false;
+        }
+        GpuDevice device = RenderSystem.getDevice();
+        this.computeFrames = device.createTexture(this.location + " (animation frames)", 5, GpuFormat.RGBA8_UNORM, widthLimit, height, 1, this.mipLevelCount);
+        for (GpuTexture t : frames) {
+            int[] origin = this.computeFrameOrigin.get(t);
+            for (int level = 0; level <= this.maxMipLevel; level++) {
+                MetalTickFx.copyLevel(t, this.computeFrames, level, origin[0] >> level, origin[1] >> level, t.getWidth(0) >> level, t.getHeight(0) >> level);
+            }
+        }
+        this.noteStreamWrite();
+        return true;
+    }
