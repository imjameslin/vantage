+            TextureAtlasSprite sprite = this.animatedSprites.get(i);
+            SpriteContents.AnimationState state = this.animatedTexturesStates.get(i);
+            int pad = padding(sprite);
+            int w = sprite.contents().width();
+            int h = sprite.contents().height();
+            int mask = (1 << this.maxMipLevel) - 1;
+            if (pad < 0 || (w & mask) != 0 || (h & mask) != 0 || (pad & mask) != 0 || state.computeFrameMipLevels() < this.mipLevelCount) {
