+    /**
+     * Stage 4: marches the clouds into the half-size target (outside any render pass, before the main pass); render then
+     * composites it. Call after prepare and Tessera's frame light block.
+     */
+    public void renderLow(final RenderTarget main) {
+        this.lowReady = false;
+        if (!Tessera.ENABLED || cloudHalf == 0 || !Tessera.INSTANCE.cloudsOn()) {
+            return;
+        }
+        int w = Math.max(1, (main.width + 1) / 2), h = Math.max(1, (main.height + 1) / 2);
+        if (this.lowTarget == null || this.lowTarget.width != w || this.lowTarget.height != h) {
+            if (this.lowTarget != null) {
+                this.lowTarget.destroyBuffers();
+            }
+            this.lowTarget = new TextureTarget("Tessera clouds (half)", w, h, GpuFormat.RGBA8_UNORM, GpuFormat.D32_FLOAT);
+        }
+        try (RenderPass pass = RenderSystem.getDevice().createCommandEncoder().createRenderPass(() -> "Tessera clouds (half)",
+                this.lowTarget.getColorTextureView(), Optional.of(new Vector4f()), this.lowTarget.getDepthTextureView(), OptionalDouble.of(0.0))) {
+            pass.setPipeline(RenderSystem.getCompiledPipeline(RenderPipelines.TESSERA_CLOUDS_LOW));
+            RenderSystem.bindDefaultUniforms(pass);
+            Tessera.INSTANCE.bindTerrain(pass, true);
+            Tessera.INSTANCE.bindClouds(pass);
+            pass.draw(3, 1, 0, 0);
+        }
+        this.lowReady = true;
+    }
