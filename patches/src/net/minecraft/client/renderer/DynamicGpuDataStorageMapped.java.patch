+    /**
+     * {@link #writeDataBatchedMultiple} with the payload written by {@code writer} (one bulk write over the same mapping)
+     * instead of one {@code write} per element: {@code listCount} lists of {@code counts[i]} elements of exactly
+     * {@code blockSize} bytes each, in list order. Same capacity growth, ring offsets and returned slices; the last data
+     * used by {@link #writeData(DynamicGpuDataStorage.DynamicGpuData)}'s dedupe is cleared (there is no element object).
+     */
+    public GpuBufferSlice[] writeRawBatchedMultiple(final int[] counts, final int listCount, final net.minecraft.client.renderer.DynamicGpuData.RawWriter writer) {
+        if (listCount == 0) {
+            return new GpuBufferSlice[0];
+        }
+
+        int totalCount = 0;
+
+        for (int i = 0; i < listCount; i++) {
+            totalCount += counts[i];
+        }
+
+        if (this.nextBlock + totalCount > this.capacity) {
+            int newCapacity = Mth.smallestEncompassingPowerOfTwo(Math.max(this.capacity + 1, totalCount));
+            LOGGER.info(
+                "Resizing {}, capacity limit of {} reached during a single frame. New capacity will be {}.",
+                new Object[]{this.label, this.capacity, newCapacity}
+            );
+            this.resizeBuffers(newCapacity);
+        }
+
+        int offset = this.nextBlock * this.blockSize;
+        GpuBufferSlice[] result = new GpuBufferSlice[listCount];
+
+        try (GpuBufferSlice.MappedView view = this.ringBuffer.currentBuffer().slice(offset, totalCount * this.blockSize).map(false, true)) {
+            GpuBuffer buffer = this.ringBuffer.currentBuffer();
+
+            for (int i = 0; i < listCount; i++) {
+                int bytes = counts[i] * this.blockSize;
+                result[i] = buffer.slice(offset, bytes);
+                offset += bytes;
+            }
+
+            if (totalCount > 0) {
+                ByteBuffer byteBuffer = view.data();
+                byteBuffer.position(0);
+                writer.write(byteBuffer);
+            }
+        }
+
+        this.nextBlock += totalCount;
+        this.lastData = null;
+        return result;
+    }
