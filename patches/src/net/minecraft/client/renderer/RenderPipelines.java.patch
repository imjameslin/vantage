+    // Stage 4 (Tessera bloom, TesseraBloom): full-screen steps of the bloom mip chain.
+    private static RenderPipeline tesseraBloom(final String location, final String fragment, final @Nullable String define, final boolean additive) {
+        RenderPipeline.Builder builder = RenderPipeline.builder()
+            .withLocation(location)
+            .withVertexShader("core/screenquad")
+            .withFragmentShader(fragment)
+            .withBindGroupLayout(BindGroupLayouts.IN_SAMPLER)
+            .withPrimitiveTopology(PrimitiveTopology.TRIANGLES)
+            .withCull(false)
+            // the chain is linear light in half floats; the composite mixes it over the frame and multiplies the vignette (premultiplied)
+            .withColorTargetState(define != null && define.equals("TESSERA_COMPOSITE")
+                ? new ColorTargetState(Optional.of(new BlendFunction(com.mojang.renderpearl.api.pipeline.BlendFactor.ONE,
+                    com.mojang.renderpearl.api.pipeline.BlendFactor.ONE_MINUS_SRC_ALPHA)), GpuFormat.RGBA8_UNORM, 7)
+                : new ColorTargetState(additive ? Optional.of(BlendFunction.ADDITIVE) : Optional.empty(), GpuFormat.RGBA16_FLOAT, additive ? 7 : 15));
+        if (define != null) {
+            builder.withShaderDefine(define);
+        }
+        return register(builder.build());
+    }
