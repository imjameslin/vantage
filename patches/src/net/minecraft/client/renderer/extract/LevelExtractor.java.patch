+    /**
+     * Zoom (docs/features/ZOOM.md): the frustum that entities / block entities brought in only by the zoom-aware
+     * distance scale must pass. Normally the view actually on screen ({@code camera.getFov()}, the zoomed projection's
+     * FOV) padded for this frame's view bob ({@link ZoomMath#cullPyramid}); vanilla's wide culling frustum when the
+     * view is distorted beyond that (hurt tilt, death roll, nausea / portal warp), the frustum is frozen (debug) or the
+     * padded view would not be narrower; null (no extra range at all) for panoramic screenshots.
+     */
+    private @Nullable Frustum zoomExtraRangeFrustum(final Camera camera, final Frustum cullFrustum) {
+        CameraRenderState cameraState = this.levelRenderState.cameraRenderState;
+        if (cameraState.isPanoramicMode) {
+            return null;
+        }
+
+        if (camera.getCapturedFrustum() != null) {
+            return cullFrustum;
+        }
+
+        // GameRenderer.bobHurt / the nausea and portal warp turn or skew the projection far more than view bob: keep the
+        // wide frustum while they act (short, rare).
+        if (cameraState.entityRenderState.isLiving && (cameraState.entityRenderState.isDeadOrDying || cameraState.entityRenderState.hurtTime > 0.0F)) {
+            return cullFrustum;
+        }
+
+        PlayerRenderState playerState = this.levelRenderState.playerRenderState;
+        float screenEffectScale = this.minecraft.options.screenEffectScale().get().floatValue();
+        if (Math.max(playerState.portalEffectIntensity, playerState.nauseaEffectIntensity) * screenEffectScale * screenEffectScale > 0.0F) {
+            return cullFrustum;
+        }
+
+        float width = this.minecraft.getWindow().getWidth();
+        float height = this.minecraft.getWindow().getHeight();
+        double bob = this.minecraft.options.bobView().get() && cameraState.entityRenderState.isPlayer ? cameraState.entityRenderState.bob : 0.0;
+        double[] pyramid = this.zoomCullPyramid;
+        if (!ZoomMath.cullPyramid(camera.getFov(), (double)width / height, bob, pyramid)) {
+            return cullFrustum;
+        }
+
+        double tanX = pyramid[0];
+        double tanY = pyramid[1];
+        double setback = pyramid[2];
+        // Vanilla's culling frustum: FOV max(fov, option fov) (Camera.createProjectionMatrixForCulling).
+        double cullTanY = Math.tan(Math.toRadians(Math.max(camera.getFov(), this.minecraft.options.fov().get().intValue())) * 0.5);
+        if (!(tanY < cullTanY) || !(tanX < cullTanY * width / height)) {
+            return cullFrustum;
+        }
+
+        float depthFar = cameraState.depthFar;
+        this.zoomCullProjection
+            .identity()
+            .perspective(
+                (float)(2.0 * Math.atan(tanY)),
+                (float)(tanX / tanY),
+                0.05F,
+                depthFar + (float)setback,
+                RenderSystem.getDevice().getDeviceInfo().isZZeroToOne()
+            );
+        Frustum frustum = new Frustum(camera.getViewRotationMatrix(this.zoomCullView), this.zoomCullProjection);
+        Vec3 pos = camera.position();
+        Vector3fc forward = camera.forwardVector();
+        frustum.prepare(pos.x - forward.x() * setback, pos.y - forward.y() * setback, pos.z - forward.z() * setback);
+        return frustum;
+    }
