+    /** Render scale: the world target for this frame (null at 100 %), with the level's targets sized to match. */
+    private @Nullable RenderTarget prepareWorldTarget(final int width, final int height) {
+        int percent = Math.max(50, Math.min(100, this.minecraft.options.renderScalePercent()));
+        int w = percent >= 100 ? width : Math.max(2, (width * percent / 100 + 1) & ~1);
+        int h = percent >= 100 ? height : Math.max(2, (height * percent / 100 + 1) & ~1);
+        if (w != this.levelWidth || h != this.levelHeight) {
+            this.resourcePool.clear();
+            this.resizeLevel(w, h);
+        }
+        if (percent >= 100) {
+            if (this.worldTarget != null) {
+                this.worldTarget.destroyBuffers();
+                this.worldTarget = null;
+            }
+            return null;
+        }
+        if (this.worldTarget == null) {
+            this.worldTarget = new MainTarget(w, h);
+        } else if (this.worldTarget.width != w || this.worldTarget.height != h) {
+            this.worldTarget.resize(w, h);
+        }
+        return this.worldTarget;
     }
 
