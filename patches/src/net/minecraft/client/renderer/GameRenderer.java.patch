+    private static final java.util.regex.Pattern METAL_SHADER_INCLUDE = java.util.regex.Pattern.compile("#\\s*(?:include|moj_import)\\s*([<\"])([^>\"]*)[>\"]");
+
+    /**
+     * TerrainShaderVariants gate: true iff core/terrain.fsh, core/terrain.vsh and every include they pull in
+     * (transitively) are served by the built-in "vanilla" pack, i.e. no resource pack overrides a terrain shader. Called
+     * on compile workers inside the reload that compiles the terrain pipelines (the manager already holds that reload's
+     * packs). Anything unexpected (missing file, quoted or unparsable include, read error) counts as overridden.
+     */
+    public static boolean metalTerrainShadersVanilla(final ResourceManager manager) {
+        java.util.ArrayDeque<Identifier> todo = new java.util.ArrayDeque<>();
+        Set<Identifier> seen = new HashSet<>();
+        todo.add(Identifier.withDefaultNamespace("shaders/core/terrain.fsh"));
+        todo.add(Identifier.withDefaultNamespace("shaders/core/terrain.vsh"));
+        while (!todo.isEmpty()) {
+            Identifier id = todo.poll();
+            if (!seen.add(id)) {
+                continue;
+            }
+
+            Optional<net.minecraft.server.packs.resources.Resource> resource = manager.getResource(id);
+            if (resource.isEmpty() || !net.minecraft.server.packs.repository.BuiltInPackSource.VANILLA_ID.equals(resource.get().sourcePackId())) {
+                return false;
+            }
+
+            String text;
+            try {
+                text = resource.get().readAllAsString();
+            } catch (IOException e) {
+                return false;
+            }
+
+            java.util.regex.Matcher m = METAL_SHADER_INCLUDE.matcher(text);
+            while (m.find()) {
+                Identifier include = m.group(1).equals("<") ? Identifier.tryParse(m.group(2)) : null;
+                if (include == null) {
+                    return false;
+                }
 
+                todo.add(include.withPrefix("shaders/include/"));
+            }
+        }
+
+        return true;
+    }
