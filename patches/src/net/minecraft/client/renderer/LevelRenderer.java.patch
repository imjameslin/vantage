+    /** The fixed 16-bit quad index buffer of S1b, created on first use. */
+    private GpuBuffer getTerrainQuadIndexBuffer() {
+        // Round 12 (b), CONTRACT 16.R12-B: TerrainToggles#quadIndexOrder picks the triangle order inside each quad (read once
+        // per frame here, abab-switchable). Every pattern covers the same two triangles with the same winding.
+        int order = Math.floorMod(TerrainToggles.quadIndexOrder, TerrainToggles.QUAD_INDEX_PATTERNS.length);
+        if (this.terrainQuadIndexBuffers == null) {
+            this.terrainQuadIndexBuffers = new GpuBuffer[TerrainToggles.QUAD_INDEX_PATTERNS.length];
+        }
+        GpuBuffer[] buffers = this.terrainQuadIndexBuffers;
+        if (buffers[order] == null) {
+            int quads = TerrainRuns.SHORT_INDEX_QUADS;
+            int[] pattern = TerrainToggles.QUAD_INDEX_PATTERNS[order];
+            ByteBuffer data = MemoryUtil.memAlloc(quads * 6 * 2);
+
+            try {
+                for (int quad = 0; quad < quads; quad++) {
+                    int v = quad * 4;
+                    for (int i = 0; i < 6; i++) {
+                        data.putShort((short)(v + pattern[i]));
+                    }
+                }
+
+                data.flip();
+                buffers[order] = RenderSystem.getDevice().createBuffer(() -> "Terrain quad index buffer", GpuBuffer.USAGE_INDEX, data);
+            } finally {
+                MemoryUtil.memFree(data);
+            }
+        }
+
+        return buffers[order];
+    }
