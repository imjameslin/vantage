+    /**
+     * Metal late frame throttle (docs/metal/CONTRACT.md 16.R5-A, results/TAIL-ANALYSIS.md S1): runTick's tick bundle in the
+     * order packets -> tasks -> tick() x n -> gizmo drain -> frame throttle -> textureManager.tick(). The frames-in-flight
+     * wait comes after the client tick, so the tick overlaps the GPU's work instead of following the wait. The texture tick
+     * records the next frame's animation passes, so it stays behind the throttle; its condition is evaluated where vanilla
+     * evaluates it (after the tasks, before the ticks). Animation steps and the client tick are independent of each other.
+     */
+    private void runTickBundleLateThrottle(final boolean advanceGameTime, final int ticksToDo, final ProfilerFiller profiler) {
+        if (!advanceGameTime) {
+            this.lateFrameThrottle(profiler);
+            return;
+        }
+
+        try (Gizmos.TemporaryCollection ignored = this.collectPerTickGizmos()) {
+            profiler.push("scheduledPacketProcessing");
+            this.packetProcessor.processQueuedPackets();
+            profiler.popPush("scheduledExecutables");
+            this.runAllTasks();
+            profiler.pop();
+        }
+
+        profiler.push("tick");
+        boolean tickTextures = ticksToDo > 0 && this.isLevelRunningNormally();
+
+        for (int i = 0; i < Math.min(10, ticksToDo); i++) {
+            profiler.incrementCounter("clientTick");
+
+            try (Gizmos.TemporaryCollection ignored = this.collectPerTickGizmos()) {
+                this.tick();
+            }
+        }
