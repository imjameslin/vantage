+     * TASK E pregrow: where spare heap buffers come from. {@link #request} never blocks and may do nothing;
+     * {@link #poll} returns a buffer created with exactly {@code usage} and {@code size}, or null. Render thread.
+     */
+    public interface HeapSource {
+        /** The Metal backend's heap-reserve thread (no-op on other backends and while the switch is off). */
+        UberGpuBuffer.HeapSource METAL_RESERVE = new UberGpuBuffer.HeapSource() {
+            @Override
+            public void request(final @GpuBuffer.Usage int usage, final long size) {
+                MetalHeapReserve.request(usage, size);
+            }
+
+            @Override
+            public @Nullable GpuBuffer poll(final @GpuBuffer.Usage int usage, final long size) {
+                return MetalHeapReserve.poll(usage, size);
+            }
+        };
+
+        void request(@GpuBuffer.Usage int usage, long size);
+
+        @Nullable GpuBuffer poll(@GpuBuffer.Usage int usage, long size);
+    }
+
+    /**
+     * TASK E per-frame upload budget ({@code -Dmc.terrain.uploadBudgetKB}), shared by every uber buffer of one
+     * SectionRenderDispatcher and mutated only under its copyLock. A frame's pass ({@link #beginFrame}) starts with
+     * {@link #budgetBytes}; a vertex-pass entry is uploaded while budget remains (the first entry always fits), when
+     * the frame flushes, when it was staged on the render thread, or once it is older than {@link #maxDelayFrames}
+     * frames, i.e. never more than maxDelayFrames frames after the pass vanilla would have uploaded it in.
+     */
+    public static final class UploadBudget {
+        public final long budgetBytes;
+        public final int maxDelayFrames;
+        /** Number of frame passes begun; an entry staged after pass f has frame f, vanilla uploads it in pass f + 1. */
+        public int frame;
+        public long remaining;
+        public boolean flush;
+        /** Statistics: carry decisions (an entry carried over k frames counts k times) / frame passes that flushed. */
+        public long carriedEntries;
+        public long flushedFrames;
+
+        public UploadBudget(final long budgetBytes, final int maxDelayFrames) {
+            this.budgetBytes = budgetBytes;
+            this.maxDelayFrames = maxDelayFrames;
+        }
+
+        public void beginFrame(final boolean flush) {
+            this.frame++;
+            this.remaining = this.budgetBytes;
+            this.flush = flush;
+            if (flush) {
+                this.flushedFrames++;
+            }
+        }
+
+        /**
+         * Whether an entry staged after pass {@code stagedFrame} is uploaded in the current pass. Index passes follow
+         * the vertex decision for the same key ({@code carriedVertex}); index-only entries are never budgeted.
+         */
+        public boolean uploadsNow(final int stagedFrame, final boolean urgent, final boolean vertexPass, final boolean carriedVertex) {
+            boolean forced = this.flush || urgent || this.frame - stagedFrame > this.maxDelayFrames;
+            if (forced) {
+                return true;
+            }
+
+            boolean now = vertexPass ? this.remaining > 0L : !carriedVertex;
+            if (!now && vertexPass) {
+                this.carriedEntries++;
+            }
+
+            return now;
+        }
+    }
 }
