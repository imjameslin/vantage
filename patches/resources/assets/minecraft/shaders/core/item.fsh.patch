 layout(location = 0) out vec4 fragColor;
 #endif
@@ -62,6 +74,24 @@
     }
     #endif
 
+#ifdef TESSERA_ENTITY
+    // Stage 4 (Tessera): during the level render (held, dropped, framed items) lit like the terrain and tonemapped;
+    // elsewhere (GUI) vanilla's look
+    if (TesseraSkyColor.w != 0.0) {
+        vec4 albedo = color * tesseraBase * ColorModulator;
+        albedo.rgb = mix(overlayColor.rgb, albedo.rgb, overlayColor.a);
+        float tesseraLit;
+        albedo.rgb = tesseraTonemap(tesseraLinear(albedo.rgb * tesseraTerrainLight(tesseraP, normalize(tesseraN), tesseraLm, 0.0, tesseraLit)));
+    #ifdef GLINT
+        vec4 glintColor = GlintAlpha * texture(GlintSampler, texCoordGlint);
+        albedo.rgb += glintColor.rgb * glintColor.rgb;
+        albedo.a = max(albedo.a, GlintAlpha);
+    #endif
+        fragColor = apply_fog(albedo, sphericalVertexDistance, cylindricalVertexDistance, FogEnvironmentalStart, FogEnvironmentalEnd,
+            FogRenderDistanceStart, FogRenderDistanceEnd, FogColor);
+        return;
+    }
+#endif
     color *= vertexColor * ColorModulator;
 
