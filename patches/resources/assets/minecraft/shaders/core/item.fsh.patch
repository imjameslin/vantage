 uniform sampler2D Sampler0;
 
@@ -28,6 +33,13 @@
 layout(location = 6) in vec2 texCoordGlint;
 #endif
 
+#ifdef TESSERA_ENTITY
+layout(location = 8) in vec3 tesseraP;
