--- a/assets/minecraft/shaders/core/clouds.fsh
+++ b/assets/minecraft/shaders/core/clouds.fsh
@@ -1,11 +1,20 @@
 #version 330
 #extension GL_ARB_separate_shader_objects : require
+#ifdef TESSERA
+#extension GL_ARB_texture_gather : require
+#endif
 
 #include <minecraft:fog.glsl>
 #include <minecraft:oit.glsl>
+#include <minecraft:tessera.glsl>
 
 layout(location = 0) in float vertexDistance;
 layout(location = 1) in vec4 vertexColor;
+#ifdef TESSERA
+layout(location = 2) in vec3 tesseraCloudPos;
+layout(location = 3) flat in vec3 tesseraCloudNormal;
+layout(location = 4) in vec3 tesseraCloudCell;
+#endif
 
 #ifndef OIT_ALPHA_ONLY
 layout(location = 0) out vec4 fragColor;
@@ -20,6 +29,25 @@
 
 void main() {
     vec4 color = vertexColor;
+#ifdef TESSERA
+    if (TesseraSkyColor.w != 0.0) {
+        // Stage 4 (Tessera): soft clouds on vanilla's geometry: white sunlit tops fading down the sides
+        // into a cool lavender underside (height within the cell layer), warm sun on the faces turned to it and a
+        // forward-scattering glow around the sun.
+        vec3 n = tesseraCloudNormal;
+        vec3 d = normalize(tesseraCloudPos);
+        vec3 l = TesseraLightDir.xyz;
+        float sun = min(TesseraLightDir.w * 2.5, 1.0);
+        vec3 cell = tesseraCloudCell;
+        float h = n.y > 0.5 ? 1.0 : (n.y < -0.5 ? 0.0 : pow(cell.y, 1.6) * 0.8 + 0.08);
+        vec3 under = vec3(0.56, 0.60, 0.82);
+        vec3 ambient = mix(under, vec3(1.0), h);
+        float ndl = max(dot(n, l), 0.0);
+        vec3 lit = ambient * (0.80 + 0.12 * sun) + TesseraSunColor.rgb * (0.10 + 0.22 * ndl) * sun;
+        lit += TesseraSunColor.rgb * tesseraGlow(d, 0.4, 0.35) * sun;
+        color.rgb *= tesseraShoulder(lit);
+    }
+#endif
     #ifndef OIT_DEPTH_BOUNDS
     color.a *= 1.0f - linear_fog_value(vertexDistance, 0, FogCloudsEnd);
     #endif
