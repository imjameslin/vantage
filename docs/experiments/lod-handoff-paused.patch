diff --git a/client/src/net/minecraft/client/renderer/chunk/LodHandoff.java b/client/src/net/minecraft/client/renderer/chunk/LodHandoff.java
new file mode 100644
--- /dev/null
+++ b/client/src/net/minecraft/client/renderer/chunk/LodHandoff.java
@@ -0,0 +1,42 @@
+package net.minecraft.client.renderer.chunk;
+
+import java.util.IdentityHashMap;
+import java.util.concurrent.atomic.AtomicLong;
+
+/** Native section coverage, keyed by rotating slot AND its current coordinate/mesh incarnation.
+ * Chunk data arriving is deliberately not evidence of coverage. A mesh is admitted only after
+ * the terrain draw-list builder has seen it fully faded in. Off-screen slots remain admitted
+ * until their mesh or coordinate changes, avoiding LOD item rebuilds on every camera turn. */
+final class LodHandoff {
+    private record Ready(long coordinate, Object mesh) {}
+    private final IdentityHashMap<Object, Ready> ready = new IdentityHashMap<>();
+    private final AtomicLong invalidations = new AtomicLong();
+    private Object view;
+    private long revision;
+
+    void begin(Object view) {
+        if (view != this.view) {
+            this.view = view;
+            this.ready.clear();
+            this.revision++;
+        }
+    }
+
+    void observe(Object slot, long coordinate, Object mesh, boolean compiled, float visibility) {
+        if (!compiled || !(visibility >= 1.0F)) return;
+        Ready old = this.ready.get(slot);
+        if (old == null || old.coordinate != coordinate || old.mesh != mesh) {
+            this.ready.put(slot, new Ready(coordinate, mesh));
+            this.revision++;
+        }
+    }
+
+    boolean covers(Object slot, long coordinate, Object mesh) {
+        Ready old = this.ready.get(slot);
+        return old != null && old.coordinate == coordinate && old.mesh == mesh;
+    }
+
+    /** EMPTY results can publish on workers; all map operations remain on the render thread. */
+    void invalidate() { this.invalidations.incrementAndGet(); }
+    long revision() { return this.revision + this.invalidations.get(); }
+}
